ocion = "Sin promocion"<br />porcentaje = 0.00</div></div></div></foreignObject><image x="1441" y="5429" width="368" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="descuento"><g transform="translate(0.5,0.5)"><rect x="1010.4" y="5580.4" width="380" height="70" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 378px; height: 1px; padding-top: 5615px; margin-left: 1011px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">descuento = subtotal * porcentaje</div></div></div></foreignObject><image x="1011" y="5608.5" width="378" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="recargo"><g transform="translate(0.5,0.5)"><rect x="990.4" y="5700.4" width="420" height="90" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 418px; height: 1px; padding-top: 5745px; margin-left: 991px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">recargo = (subtotal - descuento) *<br />(compraEnLinea ? 0.05 : 0.00)</div></div></div></foreignObject><image x="991" y="5731" width="418" height="32" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="total"><g transform="translate(0.5,0.5)"><rect x="1010.4" y="5840.4" width="380" height="80" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 378px; height: 1px; padding-top: 5880px; margin-left: 1011px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">total = subtotal - descuento + recargo</div></div></div></foreignObject><image x="1011" y="5873.5" width="378" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="inDinero"><g transform="translate(0.5,0.5)"><path d="M 950.4 6080.4 L 1050.4 5970.4 L 1450.4 5970.4 L 1350.4 6080.4 Z" fill="#ffffff" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 498px; height: 1px; padding-top: 6025px; margin-left: 951px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">Mostrar total a pagar<br />Ingresar dinero entregado<br />Leer respuesta y reemplazar ',' por '.'</div></div></div></foreignObject><image x="951" y="6004" width="498" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="tryParse"><g transform="translate(0.5,0.5)"><rect x="1000.4" y="6120.4" width="400" height="80" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 398px; height: 1px; padding-top: 6160px; margin-left: 1001px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">try:<br />dinero = Double.parseDouble(respuesta)</div></div></div></foreignObject><image x="1001" y="6146" width="398" height="32" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="catch"><g transform="translate(0.5,0.5)"><rect x="150.4" y="6130.4" width="390" height="100" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 388px; height: 1px; padding-top: 6180px; margin-left: 151px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">catch NumberFormatException:<br />dinero = 0<br />datoValido = false</div></div></div></foreignObject><image x="151" y="6159" width="388" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="valDinero"><g transform="translate(0.5,0.5)"><rect x="990.4" y="6250.4" width="420" height="90" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 418px; height: 1px; padding-top: 6295px; margin-left: 991px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">datoValido = Double.isFinite(dinero)<br />&amp;&amp; dinero &gt;= total</div></div></div></foreignObject><image x="991" y="6281" width="418" height="32" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="dDinero"><g transform="translate(0.5,0.5)"><path d="M 1210.4 6380.4 L 1320.4 6435.4 L 1210.4 6490.4 L 1100.4 6435.4 Z" fill="#ffffff" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 218px; height: 1px; padding-top: 6435px; margin-left: 1101px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">¿datoValido?</div></div></div></foreignObject><image x="1101" y="6428.5" width="218" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="dFalta"><g transform="translate(0.5,0.5)"><path d="M 1880.4 6390.4 L 2020.4 6450.4 L 1880.4 6510.4 L 1740.4 6450.4 Z" fill="#ffffff" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 278px; height: 1px; padding-top: 6450px; margin-left: 1741px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">¿dinero &gt;= 0<br />&amp;&amp; dinero &lt; total?</div></div></div></foreignObject><image x="1741" y="6436" width="278" height="32" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="errFalta"><g transform="translate(0.5,0.5)"><path d="M 1680.4 6680.4 L 1756.4 6570.4 L 2060.4 6570.4 L 1984.4 6680.4 Z" fill="#ffffff" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 378px; height: 1px; padding-top: 6625px; margin-left: 1681px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">Mostrar error:<br />El dinero no cubre el total.<br />Falta = total - dinero</div></div></div></foreignObject><image x="1681" y="6604" width="378" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="errMonto"><g transform="translate(0.5,0.5)"><path d="M 2140.4 6665.4 L 2204.4 6585.4 L 2460.4 6585.4 L 2396.4 6665.4 Z" fill="#ffffff" stroke="#000000" stroke-miterlimit="10" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 318px; height: 1px; padding-top: 6625px; margin-left: 2141px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">Mostrar error:<br />Ingrese un monto valido.</div></div></div></foreignObject><image x="2141" y="6611" width="318" height="32" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="cambio"><g transform="translate(0.5,0.5)"><rect x="1010.4" y="6570.4" width="380" height="70" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 378px; height: 1px; padding-top: 6605px; margin-left: 1011px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">cambio = dinero - total</div></div></div></foreignObject><image x="1011" y="6598.5" width="378" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-i