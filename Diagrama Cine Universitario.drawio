equiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 368px; height: 1px; padding-top: 5450px; margin-left: 1px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">case 1:<br />promocion = "Estudiante (20%)"<br />porcentaje = 0.20<br />break</div></div></div></foreignObject><image x="1" y="5421.5" width="368" height="61" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="p2"><g transform="translate(0.5,0.5)"><rect x="480.4" y="5380.4" width="370" height="140" fill="#ffffff" stroke="#000000" pointer-events="all" style="fill: var(--ge-adaptive-bg, #ffffff); stroke: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 368px; height: 1px; padding-top: 5450px; margin-left: 481px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#000000, #ffffff); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">case 2:<br />promocion = "Grupo (15%)"<br />porcentaje = 0.15<br />break</div></div></div></foreignObject><image x="481" y="5421.5" width="368" height="61" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="p3"><g transform="translate(0.5,0.5)"><rect x="960.4" y="5380.4" width="370" heig